# Copy to .env.local (local) and add the same keys in Vercel → Project → Settings → Environment Variables.
# Supabase (Settings → API). The service-role key is used ONLY on the server; never expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Google AI Studio API key for the copilot
GEMINI_API_KEY=
# Optional: comma-separated model fallback chain (this is the default)
GEMINI_MODEL=gemini-4-hydrogen,gemini-3.8-flash,gemini-3.5-flash-lite
